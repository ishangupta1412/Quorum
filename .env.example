# ==============================================================================
# Quorum — Environment Variables Template
# Copy this file to .env.local for local development. Never commit real secrets!
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Supabase Realtime Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Publicly accessible endpoint for Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (safe for browser subscriptions via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Side Service Role Key (NEVER expose to browser — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Ingest API Gatekeeping & Demo Shield
# ──────────────────────────────────────────────────────────────────────────────
# Required header 'x-quorum-secret-key' or 'x-simulation-key' on POST /api/v1/live/ingest
QUORUM_SECRET_KEY=your-quorum-secret-key-here
SIMULATION_INGEST_KEY=your-simulation-ingest-secret-key-here

# ──────────────────────────────────────────────────────────────────────────────
# AI Provider Keys — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_!
# ──────────────────────────────────────────────────────────────────────────────
ANTIGRAVITY_API_KEY=your-antigravity-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Offline & Demo Controls
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_OFFLINE=true
NEXT_PUBLIC_DEMO_CORPUS_PACK=B

# ──────────────────────────────────────────────────────────────────────────────
# Runtime Environment
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
