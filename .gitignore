# ==============================================================================
# Quorum — Strict-Exclude .gitignore
# Hardened against credential leaks, runtime dumps, OS cruft, and build cache
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Production Build & Compilation Cache ──────────────────────────────────────
.next/
out/
build/
dist/
dist-test/
*.tsbuildinfo
next-env.d.ts.bak

# ── Environment & Secret Shields (Zero Raw Credentials) ──────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
*.pem
*.key
*.crt
*.pfx
*.p12

# Explicit exception: allow only the public template
!.env.example

# ── Local Database Dumps & Cache ──────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.dump
.system_generated/
typecheck_errors.txt

# ── Logs & Debugging ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── OS & Filesystem Metadata ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── Editor & IDE State ────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# -- Graphify knowledge graph (auto-generated) --------------------
graphify-out/

.vercel

# Master defense guide (private to team)
Quorum_Master_Guide_RedmondLabs.pdf
Quorum_Master_Guide_RedmondLabs.html
scripts/build-master-guide.js
